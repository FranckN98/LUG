# --- Site (liens absolus dans les e-mails PDF) ---
# IMPORTANT : doit être le domaine réellement vérifié dans Resend (SPF/DKIM déjà
# configurés en DNS pour levelupingermany.com — voir l'audit deliverabilité).
# Ne PAS utiliser .de : ce domaine n'a aucun enregistrement SPF/DKIM et les
# e-mails envoyés avec un From sur .de échoueront l'authentification.
NEXT_PUBLIC_SITE_URL=https://www.levelupingermany.com

# --- SEO (optionnel : Search Console) ---
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-content-value-from-google

# --- Base de données (newsletter / PDF) — SQLite local ---
# Fichier créé dans prisma/ après: npx prisma migrate dev
DATABASE_URL="file:./dev.db"

# --- Administration (serveur uniquement) ---
# Générer une valeur longue et aléatoire (au moins 32 caractères) pour signer les sessions.
ADMIN_SESSION_SECRET=

# --- Formulaires (e-mail via Resend) ---
RESEND_API_KEY= 
# Destinataire des soumissions (contact, join, workshops, etc.)
FORMS_TO_EMAIL=info@levelupingermany.com
# Expéditeur vérifié dans Resend (domaine ou onboarding@resend.dev pour tests)
FORMS_FROM_EMAIL=Level Up in Germany <onboarding@resend.dev>
# Expéditeur des e-mails « PDF événement » et des campagnes newsletter
# (doit être sur un domaine vérifié dans Resend — actuellement levelupingermany.com)
NEWSLETTER_FROM_EMAIL=Level Up in Germany <info@levelupingermany.com>

# --- Newsletter : webhook Resend (bounces / plaintes / ouvertures / clics) ---
# Créer le webhook dans Resend → Webhooks → URL: <site>/api/webhooks/resend
# Événements à cocher : email.bounced, email.complained, email.delivered,
# email.opened, email.clicked, email.failed
# Coller ici le "Signing Secret" affiché par Resend pour CE webhook.
RESEND_WEBHOOK_SECRET=

# --- Newsletter : throttling de l'envoi de campagne (tous optionnels) ---
# Nombre d'e-mails envoyés en parallèle par lot.
EMAIL_BATCH_SIZE=10
# Pause (ms) entre deux lots.
EMAIL_BATCH_DELAY_MS=1000
# Nombre de tentatives supplémentaires pour les erreurs transitoires (429/5xx).
EMAIL_MAX_RETRIES=2

# --- Cloudflare Turnstile (captcha) ---
# Clé publique (visible côté client)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Clé secrète (serveur uniquement) — obligatoire en production
TURNSTILE_SECRET_KEY=

# --- WhatsApp « Rejoindre » (lien groupe recommandé) ---
# Si vide : wa.me avec numéro par défaut + message prérempli selon la langue
NEXT_PUBLIC_WHATSAPP_JOIN_URL=

